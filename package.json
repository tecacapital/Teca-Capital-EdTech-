{
  "name": "teca-capital-edtech",
  "version": "1.0.0",
  "description": "Plataforma FinTech/EdTech de Educação Financeira Audiovisual Interativa",
  "main": "backend/index.js",
  "scripts": {
    "start": "node backend/index.js",
    "dev": "nodemon backend/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint backend/ frontend/js/",
    "format": "prettier --write backend/ frontend/",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "build:frontend": "node scripts/build.js",
    "deploy": "npm run build:frontend && npm run db:migrate && npm start"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "backend/**/*.js",
      "frontend/js/**/*.js",
      "!**/node_modules/**",
      "!**/vendor/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tecacapital/teca-capital-edtech"
  },
  "keywords": [
    "edtech",
    "fintech",
    "simulador",
    "educacao-financeira",
    "angola",
    "investimentos"
  ],
  "author": "Alberto Teca Tomás",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "html-minifier": "^4.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}