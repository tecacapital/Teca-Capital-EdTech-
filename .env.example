# ============================================
# TECA CAPITAL EDTECH — EXEMPLO .env
# ============================================

# Ambiente (development | production)
NODE_ENV=development
PORT=3000

# Banco de Dados (Neon PostgreSQL)
DATABASE_URL= suar url do banco de dados 
DB_SSL=false

# JWT (altere para uma chave secreta forte em produção)
JWT_SECRET=change-this-to-a-strong-secret-key
JWT_EXPIRES_IN=7d

# CORS (origens permitidas, separadas por vírgula)
CORS_ORIGIN=http://localhost:3000

# WhatsApp (opcional - para recuperação de senha)
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_ID=your_phone_id

# Configurações da Simulação
TICK_INTERVAL_MS=5000
DATA_INICIAL=2025-01-01T00:00:00Z

# Limites
MAX_POSICOES=100
MAX_TRANSACOES_DIA=1000

# Logging (debug | info | warn | error)
LOG_LEVEL=info